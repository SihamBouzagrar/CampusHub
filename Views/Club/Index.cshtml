@using CampusHub.API.DTOs
@model List<ClubDto>
@{
    ViewData["Title"] = "EHTP Clubs";
    var isAdmin = User.IsInRole("Admin");
    var searchTerm = ViewData["SearchTerm"]?.ToString();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">EHTP Clubs</h2>
            <p class="text-muted mb-0">Discover student communities</p>
        </div>
        @if (isAdmin)
        {
            <a asp-controller="Club" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Club
            </a>
        }
    </div>

    <!-- Search form -->
    <form method="get" asp-controller="Club" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-8">
            <input type="text"
                   name="searchTerm"
                   value="@searchTerm"
                   class="form-control"
                   placeholder="Search clubs by name or category..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
        <div class="col-md-2">
            <a asp-controller="Club" asp-action="Index" class="btn btn-secondary w-100">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <p class="mb-2">No clubs found matching "@searchTerm"</p>
                <a asp-controller="Club" asp-action="Index" class="btn btn-outline-primary">View all clubs</a>
            }
            else
            {
                <p class="mb-2">No clubs available yet.</p>
                @if (isAdmin)
                {
                    <a asp-controller="Club" asp-action="Create" class="btn btn-primary">Create the first club</a>
                }
            }
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var club in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(!string.IsNullOrEmpty(club.LogoUrl) ? Url.Content("~" + club.LogoUrl) : Url.Content("~/images/default-club.png"))"
                             class="card-img-top"
                             style="height:140px; width:100%; object-fit:cover;"
                             alt="@club.Name" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold">@club.Name</h5>
                            <p class="text-muted flex-grow-1">@club.Description</p>

                            @if (!string.IsNullOrEmpty(club.Category))
                            {
                                <span class="badge bg-primary align-self-start mb-2">@club.Category</span>
                            }

                            <div class="mt-2 d-flex gap-2">
                                <a asp-controller="Club" asp-action="Details" asp-route-id="@club.Id"
                                   class="btn btn-sm btn-outline-primary">View</a>
                                @if (isAdmin)
                                {
                                    <a asp-controller="Club" asp-action="Edit" asp-route-id="@club.Id"
                                       class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-controller="Club" asp-action="Delete" asp-route-id="@club.Id"
                                       class="btn btn-sm btn-danger">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>