@model CampusHub.API.DTOs.ClubDto
@{
    ViewData["Title"] = "Club Details";
    var isAdmin = User.IsInRole("Admin");
    var isStudent = User.IsInRole("Student");
    var isMember = ViewBag.IsMember as bool? ?? false;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    
    <div class="row">
        <div class="col-md-4">
            @{
                var logoPath = string.IsNullOrEmpty(Model.LogoUrl) 
                    ? "~/images/default-club.png" 
                    : "~/" + Model.LogoUrl;
            }
<img src="@Url.Content(Model.LogoUrl)" />
        </div>
        <div class="col-md-8">
            <h2>@Model.Name</h2>
            <span class="badge bg-primary">@Model.Category</span>
            <p class="mt-3">@Model.Description</p>
            <p class="text-muted">Créé le: @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
            
            <div class="mt-4">
                @if (isStudent)
                {
                    if (isMember)
                    {
                        <span class="badge bg-success mb-2">✓ Membre</span>
                        <form asp-controller="Club" asp-action="Leave" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Leave Club</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Club" asp-action="Join" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">Join Club</button>
                        </form>
                    }
                }
                
                @if (isAdmin)
                {
                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                    </div>
                }
            </div>
            
            <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
        </div>
    </div>
</div>