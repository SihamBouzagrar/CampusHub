@model CampusHub.API.DTOs.ClubDto
@{
    ViewData["Title"] = "Delete Club";
}
<div class="container mt-5" style="max-width:600px;">
    <div class="card shadow-sm p-4 text-center">
        <h3 class="text-danger fw-bold">Delete Club</h3>
        <p>Are you sure you want to delete this club?</p>
        <h4 class="fw-bold">@Model.Name</h4>

        <form asp-controller="Club" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger w-100">Delete</button>
        </form>

        <a asp-controller="Club" asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </div>
</div>