@{
    Layout = "_Layout";
}

@model IEnumerable<CampusHub.API.DTOs.EventReadDto>
@{
    ViewData["Title"] = "Events";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="bi bi-calendar-event me-2"></i>Upcoming Events
        </h2>
        
        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i>Create Event
            </a>
        }
    </div>

    <!-- Search & Filter Bar (UNIQUE) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" class="row g-3 align-items-end">
                
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted small">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text"
                               name="search"
                               value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0 ps-0"
                               placeholder="Search events by title..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        <option value="Sport">Sport</option>
                        <option value="Tech">Tech</option>
                        <option value="Cultural">Cultural</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted small">Date</label>
                    <input type="date"
                           name="date"
                           value="@ViewBag.CurrentDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>

            </form>
            
            <!-- Reset en dessous, aligné à droite -->
            <div class="text-end mt-2">
                <a href="/events" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                </a>
            </div>
        </div>
    </div>

    <!-- Events Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <p class="text-muted mt-3 fs-5">No events found matching your criteria.</p>
            <a href="/events" class="btn btn-outline-primary">View all events</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow transition-all">
                        
                        <!-- Image avec overlay pour la catégorie -->
                        <div class="position-relative">
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:220px; object-fit:cover;"
                                 alt="@item.Title"
                                 onerror="this.src="@(item.ImageUrl ?? "/images/default-event.png") />
                            
                            <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75">
                                <i class="bi bi-people-fill me-1"></i>
                                @item.Participants.Count / @item.MaximumParticipants
                            </span>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark mb-2">@item.Title</h5>
                            
                            <div class="d-flex align-items-center text-muted mb-2">
                                <i class="bi bi-geo-alt-fill me-2 text-primary"></i>
                                <span>@item.Location</span>
                            </div>
                            
                            <div class="d-flex align-items-center text-muted mb-3">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>
                                <span>@item.EventDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <!-- Progress bar pour les participants -->
                            @{
                                var percentage = item.MaximumParticipants > 0 
                                    ? (int)((double)item.Participants.Count / item.MaximumParticipants * 100) 
                                    : 0;
                                var progressColor = percentage >= 90 ? "bg-danger" : percentage >= 70 ? "bg-warning" : "bg-success";
                            }
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar @progressColor" style="width: @percentage%"></div>
                            </div>
                            <small class="text-muted">@item.Participants.Count / @item.MaximumParticipants registered</small>
                        </div>

                        <!-- Footer avec boutons organisés -->
                        <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-3">
                            <div class="d-flex gap-2 flex-wrap">
                                
                                <!-- Details - toujours visible -->
                                <a asp-action="Details"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>

                                @if (User.IsInRole("Student"))
                                {
                                    <form asp-action="Join"
                                          asp-route-id="@item.EventId"
                                          method="post"
                                          class="flex-fill">
                                        <button type="submit"
                                                class="btn btn-success btn-sm w-100"
                                                @(item.Participants.Count >= item.MaximumParticipants ? "disabled" : "")>
                                            <i class="bi bi-check-circle me-1"></i>Join
                                        </button>
                                    </form>
                                }

                                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-warning btn-sm flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete"
                                    asp-route-id="@item.EventId"
                                        
                                          method="post"
                                          class="flex-fill"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <button type="submit"
                                                class="btn btn-danger btn-sm w-100">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                }
                                
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        transform: translateY(-2px);
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>