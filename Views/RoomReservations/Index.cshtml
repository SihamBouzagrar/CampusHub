
@using static CampusHub.Models.RoomReservation
@model IEnumerable<CampusHub.Web.DTOs.RoomReservationDto>

@{
    ViewData["Title"] = "Room Reservations";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="fw-bold">Room Reservations</h2>

        @if (User.IsInRole("Student") || User.IsInRole("Teacher"))
        {
            <a class="btn btn-primary" href="/reservations/create">
                + New Reservation
            </a>
        }

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    No reservations found.
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Room</th>
                            <th>Date</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>

                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-center">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.RoomName</td>

                                <td>@item.ReservationDate.ToString("dd/MM/yyyy")</td>

                                <td>@item.StartTime</td>

                                <td>@item.EndTime</td>

                                <!-- STATUS -->
                                <td>
                                    @if (item.Status == ReservationStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (item.Status == ReservationStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>

                                <!-- ACTIONS ADMIN -->
                               @if (User.IsInRole("Admin"))
{
    <td class="text-center">

        @if (item.Status == ReservationStatus.Pending)
        {
            <form method="post" asp-action="Approve" asp-route-id="@item.Id" class="d-inline">
                <button class="btn btn-success btn-sm">Approve</button>
            </form>

            <form method="post" asp-action="Reject" asp-route-id="@item.Id" class="d-inline">
                <button class="btn btn-danger btn-sm">Reject</button>
            </form>
        }
        else
        {
            <span class="text-muted">No actions</span>
        }

    </td>
}
                            </tr>
                        }
                    </tbody>

                </table>
            }

        </div>
    </div>
</div>