@using Microsoft.AspNetCore.Identity
@using CampusHub.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CampusHub</title>

    <!-- BOOTSWATCH CERULEAN -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

  

    <!-- CUSTOM CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">

                <img src="/images/Logo.jpg" style="height:40px;" class="me-2 rounded" />

                CampusHub EHTP

            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>

                    <a class="nav-link" asp-controller="Club" asp-action="Index">
                        Clubs
                    </a>

                    <li class="nav-item">
                        <a class="nav-link" href="/Events">
                            Events
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Reservations">
                            Rooms
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Documents" asp-action="Index">
                            Documents
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Announcements">
                            Announcements
                        </a>
                    </li>

                </ul>

                <!-- RIGHT SIDE -->
                <ul class="navbar-nav">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">

                                <img src="@(currentUser?.ProfileImageUrl ?? "/images/user.jpg")" width="35" height="35"
                                     class="rounded-circle me-1" style="object-fit:cover;" />

                                @currentUser?.FullName

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item" href="/Account/Profile">

                                        <i class="fa fa-user me-2"></i>
                                        Profile

                                    </a>
                                </li>
                              <li>
    @if (User.IsInRole("Admin"))
    {
        <a class="dropdown-item"
           asp-controller="Dashboard"
           asp-action="Index">
            Admin Dashboard
        </a>
    }
</li>

<li>
    @if (User.IsInRole("Teacher"))
    {
        <a class="dropdown-item"
           asp-controller="Dashboard"
           asp-action="Teacher">
            Teacher Dashboard
        </a>
    }
</li>
                                    <hr class="dropdown-divider">
                                </li>

                                <li>

                                    <form asp-controller="Account" asp-action="Logout" method="post">

                                        <button class="dropdown-item text-danger">

                                            <i class="fa fa-sign-out-alt me-2"></i>
                                            Logout

                                        </button>

                                      
                                    </form>
                                    <form asp-controller="Account" asp-action="Register" method="post">

                                        <button class="dropdown-item text-danger">

                                            <i class="fa fa-sign-out-alt me-2"></i>
                                            Register

                                        </button>
                                    </form>

                                </li>

                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-light" href="/Account/Login">
                                Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light" href="/Account/Register">
                                Register
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- MAIN CONTENT -->
    <main class="container mt-4">

        @RenderBody()

    </main>
    <!-- FOOTER -->
    <footer class="bg-light border-top mt-5 py-3">

        <div class="container text-center text-muted">

            © 2026 - CampusHub EHTP

        </div>

    </footer>

    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>