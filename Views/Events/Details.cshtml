@model CampusHub.API.DTOs.EventReadDto
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole("Admin");
    var isTeacher = User.IsInRole("Teacher");
    var isStudent = User.IsInRole("Student");
    var isRegistered = ViewBag.IsRegistered as bool? ?? false;
    var isFull = Model.CurrentParticipants >= Model.MaximumParticipants;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-event.png" : Model.ImageUrl)"
                 class="img-fluid rounded" style="max-height:300px;" />
        </div>
        <div class="col-md-6">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Location</p>
            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy HH:mm")</p>
            <p>
                <strong>Participants:</strong>
                <span class="badge @(isFull ? "bg-danger" : "bg-info")">
                    @Model.CurrentParticipants / @Model.MaximumParticipants
                </span>
                @if (isFull)
                {
                    <span class="text-danger ms-2">(Full)</span>
                }
            </p>
            <p>@Model.Description</p>

            <div class="d-flex gap-2 mt-3">
                @if (isStudent)
                {
                    @if (isRegistered)
                    {
                        <span class="badge bg-success">✓ Registered</span>
                        <form asp-action="Leave" asp-route-id="@Model.EventId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Cancel Participation</button>
                        </form>
                    }
                    else if (isFull)
                    {
                        <button class="btn btn-secondary" disabled>Event Full</button>
                    }
                    else
                    {
                        <form asp-action="Join" asp-route-id="@Model.EventId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">Register</button>
                        </form>
                    }
                }

                @if (isAdmin || isTeacher)
                {
                    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@Model.EventId" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this event?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                }
            </div>

            <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
        </div>
    </div>
@* ✅ LISTE DES PARTICIPANTS — UNIQUEMENT ADMIN/TEACHER *@
    @if (isAdmin || isTeacher)
    {
        @if (Model.Participants != null && Model.Participants.Any())
        {
            <h4 class="mt-4">Participants (@Model.CurrentParticipants)</h4>
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Registered At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td>@(p.FullName ?? "Unknown")</td>
                            <td>@(p.Email ?? "-")</td>
                            <td>@p.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form asp-action="RemoveParticipant" 
                                      asp-route-participationId="@p.Id" 
                                      asp-route-eventId="@Model.EventId" 
                                      method="post" 
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mt-4">No participants registered yet.</p>
        }
    }
</div>